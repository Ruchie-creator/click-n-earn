APP_NAME="Click & Earn"
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://127.0.0.1:8001
FRONTEND_URL=http://127.0.0.1:5173

# Enable only for local testing or an isolated staging preview; production must keep both false.
CLIENT_PREVIEW=false
DEMO_DATA_ENABLED=false
DEMO_BATCH_SLUG=client-preview
DEMO_BATCH_LABEL="Click & Earn Client Preview"
DEMO_MEMBER_EMAIL=demo.member@clickearn.example
DEMO_MEMBER_TWO_EMAIL=demo.member2@clickearn.example
DEMO_ADMIN_EMAIL=demo.admin@clickearn.example
# Configure three different, strong passwords outside committed files before demo:seed.
# DEMO_MEMBER_PASSWORD=
# DEMO_MEMBER_TWO_PASSWORD=
# DEMO_ADMIN_PASSWORD=

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=click_and_earn
DB_USERNAME=click_earn
DB_PASSWORD=change-me

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
PROOF_STORAGE_DISK=proofs
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

REFERRAL_REWARD_AMOUNT=12
MAX_PROOF_SIZE_KB=10240
RECEIPT_AUTO_REVIEW_THRESHOLD=0.85

PAYOUT_DRIVER=fake
FAKE_PAYOUT_OUTCOME=processing
PAYOUT_CURRENCY=USD
PAYOUT_TIMEOUT=15

AIRWALLEX_ENVIRONMENT=sandbox
AIRWALLEX_SANDBOX_BASE_URL=https://api.sandbox.airwallex.com
AIRWALLEX_PRODUCTION_BASE_URL=https://api.airwallex.com
AIRWALLEX_CLIENT_ID=
AIRWALLEX_API_KEY=
AIRWALLEX_WEBHOOK_SECRET=

VITE_APP_NAME="${APP_NAME}"

[Unit]
Description=Click & Earn Laravel scheduler (staging)
After=network-online.target postgresql.service
Wants=network-online.target

[Service]
Type=simple
User=clickearn-stage
Group=clickearn-stage
WorkingDirectory=/srv/click-and-earn/staging/app/backend
ExecStart=/usr/bin/php artisan schedule:work --no-interaction
Restart=always
RestartSec=5
TimeoutStopSec=30
KillSignal=SIGTERM
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
